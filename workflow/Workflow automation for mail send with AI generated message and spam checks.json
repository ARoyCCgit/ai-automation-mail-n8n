    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional customer support assistant for a modern business website.\n\nGenerate a warm, professional, and human-like welcome message for a contact form submission.\n\nRequirements:\n\n* Address the user by their first name using: {{ $json.body.firstname }}\n* Acknowledge their inquiry regarding: {{ $json.body.description }}\n* Keep the response concise (maximum 4-5 lines)\n* Maintain a friendly, professional, and trustworthy tone\n* Assure the user that our team will review their message and respond shortly\n* Avoid robotic or overly generic wording\n* Make the message feel personalized and premium\n\nThe final response should be plain text only without quotation marks.\n",
        "options": {
          "systemMessage": "You are a professional customer service assistant. Generate concise, friendly welcome messages for contact form submissions."
        }
      },
      "id": "4069adf6-0955-432c-938d-ba70335e2dca",
      "name": "Generate Welcome Message",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Form Webhook').item.json.body.email }}",
        "subject": "Thank you for contacting us!",
        "message": "={{ $json.output }}",
        "approvalOptions": {
          "values": {
            "approveLabel": "Email Received"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 5,
              "resumeUnit": "minutes"
            }
          },
          "appendAttribution": true
        }
      },
